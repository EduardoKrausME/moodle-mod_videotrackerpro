{{!
    @template mod_videotrackerpro/timeline

    Example context (json):
    {
        "sessionid": "9f0b8a14-example",
        "started": "6 October 2026, 14:00",
        "items": [
            {"time": "00:00", "label": "play"},
            {"time": "02:14", "label": "pause"}
        ]
    }
}}
<div class="card mb-3">
    <div class="card-body">
        <h4>{{#str}}sessiontimeline, videotrackerpro{{/str}} <small class="text-muted">{{sessionid}}</small></h4>
        <div class="small text-muted mb-2">{{started}}</div>
        <div class="videotrackerpro-timeline">
            {{#items}}
                <div class="d-flex gap-3 py-1 border-bottom">
                    <code>{{time}}</code>
                    <span>{{label}}</span>
                </div>
            {{/items}}
            {{^items}}
                <div class="text-muted">{{#str}}noevents, videotrackerpro{{/str}}</div>
            {{/items}}
        </div>
    </div>
</div>
